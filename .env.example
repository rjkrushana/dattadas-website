# DATTADAS — Environment Configuration Example

# Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Payment Gateway (Test/Live)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Email Notifications (Resend / SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key
EMAIL_FROM=support@dattadas.in

# Database (PostgreSQL / Supabase when migrating)
DATABASE_URL=postgresql://user:password@localhost:5432/dattadas

# Storage (AWS S3 / Supabase Private Storage)
STORAGE_BUCKET=dattadas-ebooks-private
STORAGE_REGION=ap-south-1
